# Keep local commit checks aligned with the project's supported runtime.
if ! command -v node >/dev/null 2>&1; then
  echo "Node.js 24.x is required. Install and activate it before committing."
  exit 1
fi

node_major="$(node -p "process.versions.node.split('.')[0]")"
if [ "$node_major" != "24" ]; then
  echo "Node.js 24.x is required; currently active: $(node --version)."
  exit 1
fi

npx lint-staged --concurrent false &&
npm run test:mutation-guards &&
echo -e "\033[32m✓ All commit steps successful\033[0m"
