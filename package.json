  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "lint:check": "npx eslint . --ext .ts,.tsx",
    "lint:fix": "npx eslint . --ext .ts,.tsx --fix",
    "prepare": "husky",
    "supabase:start": "npx supabase start",
    "supabase:stop": "npx supabase stop",
    "zero:cache": "npx zero-cache-dev",
    "zero:dev": "cross-env ZERO_UPSTREAM_DB=postgresql://postgres:postgres@127.0.0.1:54322/postgres ZERO_QUERY_URL=http://localhost:3000/api/query ZERO_MUTATE_URL=http://localhost:3000/api/mutate npx zero-cache-dev",
    "deploy": "node tools/deploy/deploy.mjs",
    "deploy:dry": "node tools/deploy/deploy.mjs --dry-run"
  },
