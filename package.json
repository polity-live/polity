{
  "name": "polity",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.18.0",
  "engines": {
    "node": "24.x"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.1": true,
    "@rocicorp/zero-sqlite3@1.1.2": true,
    "esbuild@0.28.1": true,
    "protobufjs@7.6.5": true
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "build:e2e": "node tools/e2e/build.mjs",
    "typecheck": "tsc --noEmit --pretty false",
    "start": "node .output/server/index.mjs",
    "start:e2e": "node tools/e2e/start.mjs",
    "lint": "oxlint .",
    "test": "vitest run --project unit --project component --project component-flow --project service-integration --project static-contract",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:component-flow": "vitest run --project component-flow",
    "test:service-integration": "vitest run --project service-integration",
    "test:integration": "npm run test:service-integration",
    "test:database-integration": "vitest run --project database-integration",
    "test:naming": "node tools/testing/check-test-naming.mjs",
    "test:flow-campaign": "node tools/testing/check-flow-test-campaign.mjs",
    "test:static": "npm run test:naming && npm run test:flow-campaign && npm run test:coverage:manifest && npm run test:routes && npm run test:ui-actions && npm run test:accountability && npm run test:action-catalog && vitest run --project static-contract",
    "test:coverage": "vitest run --config vitest.coverage.config.ts --project unit --project component --project component-flow --project service-integration --coverage",
    "test:coverage:shard": "node tools/testing/run-coverage-shard.mjs",
    "test:coverage:shard:help": "node tools/testing/run-coverage-shard.mjs help",
    "test:coverage:merge": "vitest --config vitest.coverage.config.ts --merge-reports .vitest-reports --coverage",
    "test:coverage:ratchet": "npm run test:coverage && node tools/testing/check-coverage-ratchet.mjs && npm run test:coverage:branches",
    "test:coverage:ratchet:update": "node tools/testing/check-coverage-ratchet.mjs --update",
    "test:coverage:changed": "node tools/testing/check-changed-coverage.mjs",
    "test:coverage:branches": "node tools/testing/check-branch-coverage-accountability.mjs",
    "test:coverage:branches:check": "node tools/testing/generate-branch-debt-inventory.mjs --check && npm run test:coverage:branches",
    "test:coverage:branches:bootstrap": "node tools/testing/generate-branch-debt-inventory.mjs --bootstrap",
    "test:coverage:branches:resolve": "node tools/testing/resolve-covered-branch-debt.mjs",
    "test:coverage:parity": "node tools/testing/compare-coverage-reports.mjs",
    "test:branch-campaign:generate": "node tools/testing/generate-branch-campaign-assignments.mjs",
    "test:branch-campaign:check": "node tools/testing/generate-branch-campaign-assignments.mjs --check",
    "test:branch-campaign:run": "node tools/testing/run-branch-assignment.mjs",
    "test:coverage:manifest": "node tools/testing/generate-coverage-manifest.mjs --check && node tools/testing/check-coverage-manifest.mjs && node tools/testing/check-coverage-debt-ratchet.mjs",
    "test:coverage:manifest:update": "node tools/testing/generate-coverage-manifest.mjs",
    "test:routes": "node tools/testing/generate-route-action-catalog.mjs --check",
    "test:routes:update": "node tools/testing/generate-route-action-catalog.mjs",
    "test:ui-actions": "node tools/testing/generate-ui-action-catalog.mjs --check && node tools/testing/check-ui-action-accountability.mjs",
    "test:ui-actions:update": "node tools/testing/generate-ui-action-catalog.mjs",
    "test:accountability": "node tools/testing/check-debt-resolution-ledger.mjs",
    "test:accountability:changed": "node tools/testing/check-changed-accountability.mjs",
    "test:accountability:coverage": "node tools/testing/check-accountability-coverage-evidence.mjs",
    "test:references:adopt-covered": "node tools/testing/adopt-covered-source-references.mjs",
    "test:references:resolve-adopted": "node tools/testing/resolve-adopted-source-references.mjs",
    "test:accountability:bootstrap": "node tools/testing/bootstrap-resolution-ledger.mjs",
    "test:debt:resolve": "node tools/testing/resolve-accountability-debt.mjs",
    "test:browser-component": "vitest run --config vitest.browser.config.ts --passWithNoTests",
    "test:mutation": "stryker run",
    "test:mutation:contract": "stryker run --dryRunOnly",
    "test:security": "node tools/testing/check-security-audit.mjs && vitest run --project unit --project component --project component-flow --project service-integration src/zero/rbac src/features/auth --passWithNoTests",
    "test:accessibility": "npm run test:e2e:prepare && playwright test --project=chromium-desktop --grep @a11y --pass-with-no-tests",
    "test:visual": "npm run test:e2e:prepare && playwright test --project=chromium-desktop --grep @visual --pass-with-no-tests",
    "test:visual:update": "npm run test:e2e:prepare && playwright test --project=chromium-desktop --grep @visual --update-snapshots",
    "test:resilience": "npm run test:e2e:prepare && playwright test --project=chromium-desktop --grep @resilience --pass-with-no-tests",
    "test:all": "npm run format:check:changed && npm run lint:check && npm run typecheck && npm run test:static && npm run test:coverage:ratchet && npm run test:coverage:changed && npm run test:browser-component && npm run test:security && npm run build",
    "test:db": "npm run test:db:coverage && npm run test:database-integration && npx supabase test db --local",
    "test:db:coverage": "tsx tools/database/check-pgtap-coverage.ts",
    "test:db:concurrency": "tsx tools/database/database-concurrency.database-integration.test.ts",
    "test:mutation-guards": "vitest run src/zero/__tests__/mutateWithServerCheck.static-contract.test.ts",
    "test:e2e:prepare": "node tools/e2e/prepare-stack.mjs",
    "test:e2e:serve": "npm run build:e2e && npm run start:e2e",
    "test:e2e": "cross-env E2E_WITH_SEED=1 npm run test:e2e:prepare && playwright test --project=chromium-desktop",
    "test:e2e:pr": "npm run test:e2e:prepare && playwright test --project=chromium-desktop --grep \"@pr\"",
    "test:e2e:pr:mobile": "npm run test:e2e:prepare && playwright test --project=chromium-mobile --grep \"@pr\"",
    "test:e2e:acceptance": "npm run test:e2e:prepare && playwright test --project=chromium-desktop --grep \"@acceptance\"",
    "test:e2e:smoke": "npm run test:e2e:pr",
    "test:e2e:nightly": "cross-env E2E_WITH_SEED=1 npm run test:e2e:prepare && playwright test --config=playwright.nightly.config.ts",
    "test:e2e:performance": "npm run test:e2e:prepare && playwright test --project=chromium-desktop --grep \"@performance\"",
    "test:e2e:stress": "npm run test:e2e:prepare && playwright test --project=chromium-desktop --grep \"@pr\" --repeat-each=20 --workers=1",
    "test:e2e:ui": "cross-env E2E_WITH_SEED=1 npm run test:e2e:prepare && cross-env PLAYWRIGHT_OUTPUT_DIR=test-results-ui PLAYWRIGHT_REPORT_DIR=playwright-report-ui playwright test --ui --project=chromium-desktop",
    "test:e2e:headed": "cross-env E2E_WITH_SEED=1 npm run test:e2e:prepare && cross-env PLAYWRIGHT_OUTPUT_DIR=test-results-headed PLAYWRIGHT_REPORT_DIR=playwright-report-headed playwright test --headed --project=chromium-desktop --workers=1",
    "test:e2e:debug": "cross-env E2E_WITH_SEED=1 npm run test:e2e:prepare && cross-env PLAYWRIGHT_OUTPUT_DIR=test-results-debug PLAYWRIGHT_REPORT_DIR=playwright-report-debug playwright test --debug --project=chromium-desktop",
    "test:action-catalog": "node tools/testing/check-action-catalog.mjs",
    "email:dev": "email dev --dir emails --port 3001",
    "email:check": "tsx tools/email/check-templates.ts",
    "email:template:deploy": "tsx tools/email/deploy-template.ts",
    "email:auth:build": "tsx tools/email/build-auth-templates.ts",
    "email:auth:check": "tsx tools/email/check-auth-templates.ts",
    "email:auth:deploy": "tsx tools/email/deploy-auth-templates.ts",
    "i18n:audit": "tsx tools/i18n/audit.ts",
    "osm:tutorial:capture": "tsx tools/osm/capture-euckenstrasse-tutorial-fixture.ts",
    "stripe:listen": "stripe listen --events checkout.session.completed,customer.subscription.created,customer.subscription.updated,customer.subscription.deleted,invoice.payment_succeeded,invoice.payment_failed --forward-to http://localhost:3000/api/stripe/webhook",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "format:check:changed": "node tools/testing/check-changed-format.mjs",
    "lint:check": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "prepare": "husky",
    "supabase:start": "npx supabase start",
    "supabase:stop": "npx supabase stop",
    "zero:cache": "cross-env ZERO_CVR_GARBAGE_COLLECTION_INACTIVITY_THRESHOLD_HOURS=0.25 ZERO_CVR_GARBAGE_COLLECTION_INITIAL_INTERVAL_SECONDS=30 ZERO_CVR_GARBAGE_COLLECTION_INITIAL_BATCH_SIZE=100 npx zero-cache-dev",
    "zero:dev": "cross-env ZERO_UPSTREAM_DB=postgresql://postgres:postgres@127.0.0.1:54322/postgres ZERO_QUERY_URL=http://localhost:3000/api/query ZERO_MUTATE_URL=http://localhost:3000/api/mutate ZERO_CVR_GARBAGE_COLLECTION_INACTIVITY_THRESHOLD_HOURS=0.25 ZERO_CVR_GARBAGE_COLLECTION_INITIAL_INTERVAL_SECONDS=30 ZERO_CVR_GARBAGE_COLLECTION_INITIAL_BATCH_SIZE=100 npx zero-cache-dev",
    "zero:clean": "node tools/zero/clean-dev-cache.mjs",
    "zero:stats": "cross-env ZERO_UPSTREAM_DB=postgresql://postgres:postgres@127.0.0.1:54322/postgres node tools/zero/stats.mjs",
    "deploy": "node tools/deploy/deploy.mjs",
    "deploy:dry": "node tools/deploy/deploy.mjs --dry-run"
  },
