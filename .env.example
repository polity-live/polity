# Environment strategy
#
# - .env.development.local  => Supabase local development
# - .env.production.local   => Supabase cloud / production build values
# - .env                    => keep empty or use only for shared non-sensitive defaults
#
# Vinxi/Vite resolves these files automatically by mode.
# Copy the block below into the appropriate mode-specific file and adjust values.

# Web Push Notifications (VAPID Keys)
VAPID_PUBLIC_KEY="your_vapid_public_key_here"
VAPID_PRIVATE_KEY="your_vapid_private_key_here"
VAPID_EMAIL="mailto:your-email@example.com"
VITE_VAPID_PUBLIC_KEY="your_vapid_public_key_here"

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key_here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_or_secret_key_here
# Personal Management API credentials used only by email:auth:deploy.
SUPABASE_ACCESS_TOKEN=your_supabase_personal_access_token_here
SUPABASE_PROJECT_REF=your-project-ref

#
# Zero Cache
VITE_ZERO_CACHE_URL=https://zero.your-domain.example
VITE_APP_URL=https://your-app-domain.example

# AI
# OPENROUTER_API_KEY enables shared free OpenRouter models for all users.
# AI_ENCRYPTION_SECRET encrypts per-user BYOK credentials at rest on the server.
OPENROUTER_API_KEY=your_openrouter_api_key_here
AI_ENCRYPTION_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# Geoapify
VITE_GEOAPIFY_API_KEY=8da7a649b82042d1bfa9e2a49f69d1f3

# GENESIS data provider
GENESIS_API_TOKEN=your_genesis_destatis_api_token_here
GENESIS_BASE_URL=https://genesis.destatis.de/genesisWS/rest/2020/

# Database
# Vercel: use session pooler (pooler.supabase.com:5432)
# Fly.io zero-cache: override ZERO_UPSTREAM_DB with direct connection via `fly secrets set`
#   ZERO_UPSTREAM_DB=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres?sslmode=require
ZERO_UPSTREAM_DB=postgresql://postgres.your-project:your_database_password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require
ZERO_CVR_DB=postgresql://postgres.your-project:your_database_password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require
ZERO_CHANGE_DB=postgresql://postgres.your-project:your_database_password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require
ZERO_ADMIN_PASSWORD=your_zero_admin_password_here

# Zero Cache OpenTelemetry (server only)
# Supplying an OTLP endpoint activates Zero's native query transformation,
# hydration, lock wait, pipeline reset, CVR flush, and replication lag metrics.
OTEL_EXPORTER_OTLP_ENDPOINT=https://your-otel-collector.example
OTEL_EXPORTER_OTLP_HEADERS=authorization=your_collector_token
OTEL_SERVICE_NAME=polity-zero
OTEL_NODE_ENABLED_INSTRUMENTATIONS=http

# Google OAuth (Supabase Auth external provider)
SUPABASE_AUTH_GOOGLE_CLIENT_ID=your_prod_google_client_id_here
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=your_prod_google_client_secret_here

# Stripe Payment Integration
STRIPE_MODE=test
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
STRIPE_PRICE_RUNNING=price_your_stripe_running_price_here
STRIPE_PRICE_DEVELOPMENT=price_your_stripe_development_price_here
STRIPE_PRODUCT_CUSTOM=prod_your_stripe_custom_amount_product_here
STRIPE_PORTAL_CONFIGURATION_ID=bpc_your_stripe_portal_configuration_here

# Resend newsletter integration (server only)
# Production uses separate German and English segments. Development uses only English.
RESEND_API_KEY=your_resend_full_access_api_key_here
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_secret_here
RESEND_SEGMENT_ID_DE=your_resend_production_german_segment_id_here
RESEND_SEGMENT_ID_EN=your_resend_english_segment_id_here
RESEND_TOPIC_ID=your_resend_newsletter_topic_id_here
NEWSLETTER_SYNC_SECRET=replace_with_a_long_random_secret
NEWSLETTER_ENVIRONMENT=development
NEWSLETTER_SYNC_ENABLED=false
# Comma-separated exact addresses or domains prefixed with @. Ignored in production.
NEWSLETTER_ALLOWED_RECIPIENTS=developer+dev@example.com,@resend.dev
