# App server and both services. Use separate least-privilege service credentials in production.
STUDIO_ENABLED=true
VITE_STUDIO_ENABLED=true
STUDIO_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# App server returns this browser-reachable address to authenticated editors.
STUDIO_WEBSOCKET_URL=ws://localhost:1235
# Optional comma-separated user UUIDs. Apply the same list to app and collaboration server.
STUDIO_PILOT_USER_IDS=
PORT=1235
# Optional absolute executable paths; omit when installed on PATH / by Playwright.
FFMPEG_PATH=
STUDIO_CHROMIUM_PATH=
