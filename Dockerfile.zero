FROM node:22-bookworm-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install --no-install-recommends -y python3 make g++ libreadline-dev libncurses-dev \
    && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./

RUN npm ci --omit=dev --ignore-scripts \
    && node node_modules/@rocicorp/zero-sqlite3/deps/gen-unicode-case.mjs > node_modules/@rocicorp/zero-sqlite3/src/util/unicode_case_data.h \
    && npm rebuild @rocicorp/zero-sqlite3 --build-from-source \
    && npm cache clean --force

EXPOSE 4848

CMD ["./node_modules/.bin/zero-cache"]
