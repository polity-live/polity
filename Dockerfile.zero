FROM node:24-bookworm-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install --no-install-recommends -y python3 make g++ libreadline-dev libncurses-dev \
    && rm -rf /var/lib/apt/lists/*

RUN npm install --global npm@11.18.0

COPY package.json package-lock.json ./

RUN npm ci --omit=dev --ignore-scripts \
    && node node_modules/@rocicorp/zero-sqlite3/deps/gen-unicode-case.mjs > node_modules/@rocicorp/zero-sqlite3/src/util/unicode_case_data.h \
    && npm --prefix node_modules/@rocicorp/zero-sqlite3 run build-release \
    && npm cache clean --force

EXPOSE 4848

CMD ["./node_modules/.bin/zero-cache"]
