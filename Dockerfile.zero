FROM node:24.21.0-bookworm-slim

WORKDIR /app

RUN corepack enable \
    && corepack prepare pnpm@10.34.6 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

RUN pnpm install --prod --frozen-lockfile --ignore-scripts \
    && pnpm rebuild @parcel/watcher @rocicorp/zero-sqlite3 esbuild protobufjs \
    && pnpm store prune

EXPOSE 4848

COPY tools/zero ./tools/zero
COPY tools/shared/run-cli-if-main.mjs ./tools/shared/run-cli-if-main.mjs
RUN chmod +x tools/zero/bin/zero-cache

CMD ["node", "tools/zero/run-cache.mjs"]
